APP_NAME="Mts. Iglit-Baco Natural Park"
APP_ENV=production
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_URL=https://park.example.gov.ph

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mibnp
DB_USERNAME=mibnp
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
# Port 587 uses smtp with automatic STARTTLS. For implicit TLS on port 465,
# change this to smtps and change MAIL_PORT to 465.
MAIL_SCHEME=smtp
MAIL_HOST=smtp.example.gov.ph
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS="noreply@park.example.gov.ph"
MAIL_FROM_NAME="${APP_NAME}"
VISITATION_REQUEST_EMAIL="r4b.mibnp@denr.gov.ph"

# Comma-separated hostnames only. Do not include schemes, ports, or paths.
TRUSTED_HOSTS=park.example.gov.ph

# Leave empty when Laravel is directly internet-facing. When a reverse proxy or
# CDN is used, provide only its IP addresses or CIDR ranges; never use "*".
TRUSTED_PROXIES=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
